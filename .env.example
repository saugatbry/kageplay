# Upstash Redis (Vercel KV) — optional but recommended for persistent caching
# Get these from https://console.upstash.com or Vercel KV dashboard
# UPSTASH_REDIS_REST_URL=https://your-region.upstash.io
# UPSTASH_REDIS_REST_TOKEN=your-token

# OR if using Vercel KV integration, the env vars are auto-injected:
# KV_REST_API_URL=...
# KV_REST_API_TOKEN=...

# PocketBase (optional) — required for bookmarks, watch history, and profile features
# Get PocketBase from https://pocketbase.io/docs/ and run `pocketbase serve`
# NEXT_PUBLIC_POCKETBASE_URL=http://127.0.0.1:8090

# Premium — Google Apps Script verification endpoint
# Deploy a Google Apps Script web app that exposes GET ?utr=XXX
# Returns JSON: { success: true, utr, amount, used } or { success: false }
NEXT_PUBLIC_GOOGLE_SCRIPT_URL=

# Premium — UPI / QR payment details
NEXT_PUBLIC_UPI_ID=psyflowz@fam
NEXT_PUBLIC_UPI_NAME=KagePlay
NEXT_PUBLIC_QR_IMAGE=/famPayQr.png

# Firebase (optional) — for premium payment/subscription persistence
# Create a project at https://console.firebase.google.com, enable Firestore
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
